#!/bin/bash

## submitted by start_sbatch_power.sh as
##   sbatch --job-name=diff_sim12_${ip}_${ialpha}_power sbatch_sim12_power ip ialpha
##
## JULIA (default: julia) and SCRATCH (default: $HOME/scratch) can be set in the
## environment. Results go to $SCRATCH/diffTest/sim12_o_power_${1}_${2}, logs to
## $SCRATCH/output/sim12_o_power_${1}_${2}. Pass the partition for your cluster to sbatch
## (sbatch -p ...).

#SBATCH --ntasks=28
#SBATCH --time=7-00:00:00

JULIA=${JULIA:-julia}
SCRATCH=${SCRATCH:-$HOME/scratch}
PROJECT=$SLURM_SUBMIT_DIR/..
OUT=$SCRATCH/diffTest/sim12_o_power_${1}_${2}
LOG=$SCRATCH/output/sim12_o_power_${1}_${2}

mkdir -p $OUT
mkdir -p $LOG

command -v parallel > /dev/null || module load parallel

# one BLAS thread per worker; install and precompile once before the workers start
export OPENBLAS_NUM_THREADS=1
$JULIA --project=$PROJECT -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

parallel --delay .2 -j $SLURM_NTASKS --joblog __$SLURM_JOB_NAME.runtask.log --resume srun --exclusive -N1 -n1 --error=$LOG/$SLURM_JOB_NAME.err.{1} --output=$LOG/$SLURM_JOB_NAME.out.{1} $JULIA --project=$PROJECT sim12_o_power.jl {1} ${1} ${2} $OUT ::: {1..1000}
