#!/bin/bash

## submit as
##   sbatch sbatch_sim5b
##
## JULIA (default: julia) and SCRATCH (default: $HOME/scratch) can be set in the
## environment. Results go to $SCRATCH/diffTest/sim5b, logs to
## $SCRATCH/output/sim5b. Pass the partition for your cluster to sbatch
## (sbatch -p ...).

#SBATCH --ntasks=50
#SBATCH --time=1-12:00:00
#SBATCH --job-name=diff_sim5b

JULIA=${JULIA:-julia}
SCRATCH=${SCRATCH:-$HOME/scratch}
PROJECT=$SLURM_SUBMIT_DIR/..
OUT=$SCRATCH/diffTest/sim5b
LOG=$SCRATCH/output/sim5b

mkdir -p $OUT
mkdir -p $LOG

command -v parallel > /dev/null || module load parallel

# one BLAS thread per worker; install and precompile once before the workers start
export OPENBLAS_NUM_THREADS=1
$JULIA --project=$PROJECT -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

parallel --delay .2 -j $SLURM_NTASKS --joblog __$SLURM_JOB_NAME.runtask.log --resume srun --exclusive -N1 -n1 --error=$LOG/$SLURM_JOB_NAME.err.{1} --output=$LOG/$SLURM_JOB_NAME.out.{1} $JULIA --project=$PROJECT sim5b.jl {1} $OUT ::: {1..100}
