#!/bin/bash

## submitted by start_sbatch.sh as
##   sbatch --job-name=diff_sim11_${ip} sbatch_sim11 ip script
## with script sim11 (estimated supports) or sim11_o (oracle supports)
##
## JULIA (default: julia) and SCRATCH (default: $HOME/scratch) can be set in the
## environment. Results go to $SCRATCH/diffTest/$SCRIPT, logs to
## $SCRATCH/output/$SCRIPT. Pass the partition for your cluster to sbatch
## (sbatch -p ...).

#SBATCH --ntasks=200
#SBATCH --time=1-12:00:00

JULIA=${JULIA:-julia}
SCRATCH=${SCRATCH:-$HOME/scratch}
PROJECT=$SLURM_SUBMIT_DIR/..
SCRIPT=${2:-sim11}
OUT=$SCRATCH/diffTest/$SCRIPT
LOG=$SCRATCH/output/$SCRIPT

mkdir -p $OUT
mkdir -p $LOG

command -v parallel > /dev/null || module load parallel

# one BLAS thread per worker; install and precompile once before the workers start
export OPENBLAS_NUM_THREADS=1
$JULIA --project=$PROJECT -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

parallel --delay .2 -j $SLURM_NTASKS --joblog __$SLURM_JOB_NAME.runtask.log --resume srun --exclusive -N1 -n1 --error=$LOG/$SLURM_JOB_NAME.err.{1} --output=$LOG/$SLURM_JOB_NAME.out.{1} $JULIA --project=$PROJECT $SCRIPT.jl {1} ${1} $OUT ::: {1..1000}
